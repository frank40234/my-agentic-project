  "module_name": "Inventory Module (庫存管理)",
  "sub_modules": [],
  "database_schema": [
    {
      "table": "Inventories",
      "description": "紀錄資產在儲位的數量與最後異動時間"
    }
  ],
  "api_specs": [
    {
      "id": "API-INVENTORY-001",
      "method": "GET",
      "path": "/Inventory/Index",
      "description": "庫存一覽表查詢，可查詢各儲位存放的資產與數量，支援關鍵字篩選(物料編碼、型號、品名、儲位)。",
      "auth": "EAM_AUTH_COOKIE",
      "roles": [],
      "request": {
        "searchQuery": "string, 可選",
        "warehouseId": "int, 可選"
      },
      "response": { "html": "庫存一覽表 UI" }
    },
    {
      "id": "API-INVENTORY-002",
      "method": "POST",
      "path": "/Inventory/AdjustQuantity",
      "description": "庫存調整（增減數量），後端會寫入/更新 Inventories 表並自動更新最後異動時間與修改人資訊。",
      "auth": "EAM_AUTH_COOKIE",
      "roles": [],
      "request": {
        "AssetId": "int, 必填",
        "StorageLocationId": "int, 必填",
        "Quantity": "int, 必填 (可為正或負)"
      },
      "response": { "success": "boolean", "newQuantity": "int" }
    }
  ],
