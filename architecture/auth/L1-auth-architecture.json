      "id": "API-AUTH-001",
      "method": "GET",
      "path": "/Auth/Simulator",
      "description": "提供開發測試人員輸入工號與姓名的模擬頁面。",
      "auth": "none",
      "roles": [],
      "request": {},
      "response": { "html": "模擬登入 UI" }
    },
    {
      "id": "API-AUTH-002",
      "method": "POST",
      "path": "/Auth/SimulateLogin",
      "description": "接收模擬表單，產生夾帶工號與姓名 Claims 的 5 分鐘 Cookie (Cookie 名稱: EAM_AUTH_COOKIE) 並導向首頁。",
      "auth": "none",
      "roles": [],
      "request": {
        "EmployeeNo": "string, 必填",
        "EmployeeName": "string, 必填"
      },
      "response": { "redirect": "/Home/Index" }
    },
    {
      "id": "API-AUTH-003",
      "method": "GET",
      "path": "/Auth/AccessDenied",
      "description": "當請求未被驗證 (缺少 Cookie 或已過期) 時，跳轉至此說明頁面。",
      "auth": "none",
      "roles": [],
      "request": {},
      "response": { "html": "未授權提示 UI" }
    },
    {
      "id": "API-AUTH-004",
      "method": "POST",
      "path": "/Auth/Logout",
      "description": "清除 EAM_AUTH_COOKIE，登出使用者。",
      "auth": "none",
      "roles": [],
      "request": {},
      "response": { "redirect": "/Auth/AccessDenied" }
    }
