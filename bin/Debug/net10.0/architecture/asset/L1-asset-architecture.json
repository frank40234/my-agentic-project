  "module_id": "MOD-002",
  "module_name": "Asset Module (資產分類與主檔)",
  "sub_modules": [],
  "database_schema": [
    {
      "table": "MajorCategories",
      "description": "包含大類代號與名稱"
    },
    {
      "table": "MinorCategories",
      "description": "包含次類代號與名稱，必須歸屬於某個大類"
    },
    {
      "table": "ItemNames",
      "description": "包含品名代號與名稱，必須歸屬於某個次類"
    },
    {
      "table": "Units",
      "description": "獨立的單位表，紀錄代碼與名稱"
    },
    {
      "table": "Assets",
      "description": "資產基本資訊表，歸屬於品名、設定單位與預設儲位，系統自動產生 MaterialCode"
    }
  ],
  "api_specs": [
    {
      "id": "API-ASSET-001",
      "method": "GET",
      "path": "/Asset/GetMinorCategoriesByMajor",
      "description": "AJAX 連動 API，根據大類ID取得所有啟用的次類清單。",
      "auth": "EAM_AUTH_COOKIE",
      "roles": [],
      "request": { "majorCategoryId": "int" },
      "response": [ { "id": "int", "code": "string", "name": "string" } ]
    },
    {
      "id": "API-ASSET-002",
      "method": "GET",
      "path": "/Asset/GetItemNamesByMinor",
      "description": "AJAX 連動 API，根據次類ID取得所有啟用的品名清單。",
      "auth": "EAM_AUTH_COOKIE",
      "roles": [],
      "request": { "minorCategoryId": "int" },
      "response": [ { "id": "int", "code": "string", "name": "string" } ]
    },
    {
      "id": "API-ASSET-003",
      "method": "POST",
      "path": "/Asset/Create",
      "description": "新增資產基本資訊，後端在此發動資材物料編碼算號引擎，防範併發衝突並寫入資料庫。",
      "auth": "EAM_AUTH_COOKIE",
      "roles": [],
      "request": {
        "ItemNameId": "int, 必填",
        "UnitId": "int, 必填",
        "DefaultStorageLocationId": "int, 可選",
        "Model": "string, 必填",
        "Brand": "string, 必填"
      },
      "response": { "success": "boolean", "materialCode": "string" }
    }
  ],
  "events_published": [],
  "events_subscribed": [],
  "extension_points": [
    {
      "id": "EXT-ASSET-001",
      "location": "IMaterialCodeGenerator",
      "description": "定義產生 MaterialCode 的介面，方便未來改為其他編碼格式。"
    }
  ]
}
