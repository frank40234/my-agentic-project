  },
  "project_name": "EAM_Company_Asset_Management_System",
  "overview": "公司資產管理系統 (EAM) 提供資產分類、資產主檔維護、倉庫與儲位管理、庫存管理，並使用 Cookie 單一登入驗證（時效 5 分鐘，接收外部系統 Cookie）與 jQuery 前端驗證，具備完整的異動追蹤與邏輯刪除機制。",
  "tech_stack": {
    "project_type": "fullstack",
    "primary_language": "C# 14",
    "framework": "ASP.NET Core 10.0 MVC",
    "database": "SQL Server",
    "orm": "Entity Framework Core 10.0",
    "auth": "ASP.NET Core Cookie Authentication (自訂 Cookie 名稱，5分鐘時效，Claims 含工號與姓名)",
    "api_style": "REST",
    "ui_framework": "Bootstrap 5",
    "styling": "Vanilla CSS & Bootstrap 5",
    "state_management": "Server-side Session/Claims",
    "additional": {
      "js_library": "jQuery 3.7.1",
      "validation": "jQuery Validation Plugin"
    }
  },
  "modules": [
    {
      "id": "MOD-001",
      "name": "Auth Module (身分驗證與模擬器)",
      "description": "負責處理 Cookie 驗證，設定過期時間 5 分鐘，並提供開發模擬頁面以便寫入工號與姓名 Claims 的驗證 Cookie。",
      "architecture_file": "auth/L1-auth-architecture.json",
      "priority": 1,
      "status": "pending",
      "dependencies": []
    },
    {
      "id": "MOD-002",
      "name": "Asset Module (資產分類與主檔)",
      "description": "管理大類、次類、品名、單位、資產基本資訊，並提供資材物料編碼自動生成引擎 (格式：大類代碼-次類代碼-品名代號-4位流水號)。",
      "architecture_file": "asset/L1-asset-architecture.json",
      "priority": 2,
      "status": "pending",
      "dependencies": ["MOD-001"]
    },
    {
      "id": "MOD-003",
      "name": "Warehouse Module (倉庫與儲位)",
      "description": "管理資材室與儲位（儲位歸屬於資材室），提供關聯 CRUD 與下拉連動。",
      "architecture_file": "warehouse/L1-warehouse-architecture.json",
      "priority": 3,
      "status": "pending",
      "dependencies": ["MOD-001"]
    },
    {
      "id": "MOD-004",
      "name": "Inventory Module (庫存管理)",
      "description": "整合資產與儲位，記錄與異動庫存數量，提供一目了然的庫存一覽表查詢介面。",
      "architecture_file": "inventory/L1-inventory-architecture.json",
      "priority": 4,
      "status": "pending",
      "dependencies": ["MOD-001", "MOD-002", "MOD-003"]
    }
  ],
  "cross_module_contracts": [
    {
      "from": "MOD-001",
      "to": "MOD-002",
      "event_or_api": "HttpContext.User.Claims",
      "description": "資產主檔模組需要從登入 Cookie 中取得建立人與修改人姓名/工號。",
      "mechanism": "Shared Claims Principal"
    },
    {
      "from": "MOD-001",
      "to": "MOD-003",
      "event_or_api": "HttpContext.User.Claims",
      "description": "倉庫儲位模組需要從登入 Cookie 中取得建立人與修改人姓名/工號。",
      "mechanism": "Shared Claims Principal"
    },
    {
      "from": "MOD-001",
      "to": "MOD-004",
      "event_or_api": "HttpContext.User.Claims",
      "description": "庫存管理模組需要從登入 Cookie 中取得建立人與修改人姓名/工號。",
      "mechanism": "Shared Claims Principal"
    },
    {
      "from": "MOD-002",
      "to": "MOD-004",
      "event_or_api": "Asset Data Access",
      "description": "庫存模組需要引用資產基本資訊與物料編碼進行庫存顯示。",
      "mechanism": "Shared DB"
    },
    {
      "from": "MOD-003",
      "to": "MOD-004",
      "event_or_api": "Storage Location Data Access",
      "description": "庫存模組需要引用儲位與資材室資訊進行庫存存放位置顯示。",
      "mechanism": "Shared DB"
    }
  ],
  "shared_infrastructure": {
    "auth": "Cookie Authentication (名稱: EAM_AUTH_COOKIE, 時效: 5分鐘, 夾帶 Claims: EmployeeNo, EmployeeName)",
    "logging": "ASP.NET Core Built-in Logging (Console & Debug)",
    "caching": "None",
    "monitoring": "None"
  },
